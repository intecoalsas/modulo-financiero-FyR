# Copiar a .env y llenar los valores reales. Nunca subir el .env a git.
# Clave larga y aleatoria para sesiones (obligatoria en producción)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Flask: development | production (production activa HTTPS y cabeceras)
FLASK_ENV=development
# Conexión a Postgres en la nube (Neon/Supabase). Vacía = SQLite local.
# Ejemplo: postgresql+psycopg://usuario:clave@host/db?sslmode=require
DATABASE_URL=
# Tamaño máximo de subida en MB (60 por el archivo de Villavicencio/EMSA)
MAX_UPLOAD_MB=60
# 0 = elimina los Excel subidos al terminar de procesar (los originales ya
# están guardados en otro lugar; lo que se conserva es la BD y las descargas
# se regeneran solas). 1 = los conserva para reconstrucciones/auditoría.
CONSERVAR_ORIGINALES=0
# API key de Google Gemini para el "Análisis IA" (tier gratis, sin tarjeta).
# Crear en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar (opcional). Vacío = se prueban varios en orden.
# GEMINI_MODEL=gemini-2.0-flash
