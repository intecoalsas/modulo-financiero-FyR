# Copiar a .env y llenar los valores reales. Nunca subir el .env a git.
# Clave larga y aleatoria para sesiones (obligatoria en producción)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Flask: development | production (production activa HTTPS y cabeceras)
FLASK_ENV=development
# Conexión a Postgres en la nube (Neon/Supabase). Vacía = SQLite local.
# Ejemplo: postgresql+psycopg://usuario:clave@host/db?sslmode=require
DATABASE_URL=
# Tamaño máximo de subida en MB (80 por el archivo de Villavicencio/EMSA)
MAX_UPLOAD_MB=80
# 0 = elimina los Excel subidos al terminar de procesar (los originales ya
# están guardados en otro lugar; lo que se conserva es la BD y las descargas
# se regeneran solas). 1 = los conserva para reconstrucciones/auditoría.
CONSERVAR_ORIGINALES=0
# Depuración de espacio: el detalle de cuentas (las filas de facturación y
# recaudo) solo se conserva en los últimos N informes mensuales de cada
# comercializadora; el más antiguo se depura al guardar uno nuevo. El
# resumen de cada informe queda intacto en la plataforma.
CONSERVAR_DETALLES=6
# API key de Google Gemini para el "Análisis IA" (tier gratis, sin tarjeta).
# Crear en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar (opcional). Vacío = se prueban varios en orden.
# GEMINI_MODEL=gemini-2.0-flash
# Turso (base de datos en la nube, libSQL). Se activa poniendo ambas
# variables: la URL sale de turso.tech/app -> Database, y el token de
# turso.tech/app -> Database -> (la base) -> Tokens (solo de ESA base).
# TURSO_DATABASE_URL=libsql://mi-db-miorg.turso.io
# TURSO_AUTH_TOKEN=token-de-la-base
# Precarga de la cartera de San Pedro: ruta al libro de referencia
# "Clientes Especiales SP 2026.xlsx". Si no se pone, al arrancar se busca
# el .xlsx más nuevo en backend/uploads/referencia/. Solo se usa si la
# cartera está vacía (nunca sobrescribe una cartera con datos).
# CARTERA_REFERENCIA=C:\ruta\clientes especiales sp 2026.xlsx
